# ==============================================================================
# MILO Backend Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://postgres:kart%402004@localhost:5432/milo_db

# Environment & Debug Mode
ENVIRONMENT=development
DEBUG=true

# Security
JWT_SECRET_KEY=milo-super-secret-jwt-key-change-in-production-min-32-chars

# ==============================================================================
# SMTP Email Dispatch Configuration (Real Email to Inboxes)
# ==============================================================================
# To deliver real OTP emails to Gmail/Yahoo/Outlook inboxes:
# 1. Enable 2-Step Verification in your Google Account.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Name (e.g. "MILO Backend") and generate a 16-letter App Password.
# 4. Fill in the values below:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME=MILO Verification

# ==============================================================================
# SMS Gateway Configuration (Optional - Twilio)
# ==============================================================================
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
